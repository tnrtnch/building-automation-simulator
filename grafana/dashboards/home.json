{
  "uid": "climate-home",
  "title": "Smart Home Climate",
  "tags": [
    "building",
    "hvac"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "room",
        "label": "Room",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "climate-pg"
        },
        "query": "SELECT DISTINCT room FROM telemetry WHERE floor = 'f1' ORDER BY 1",
        "refresh": 2,
        "sort": 1,
        "current": {
          "text": "living_room",
          "value": "living_room"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Temperature, all rooms (\u00b0C)",
      "datasource": {
        "type": "postgres",
        "uid": "climate-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "climate-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT ts AS time, room AS metric, temperature FROM telemetry WHERE $__timeFilter(ts) AND floor = 'f1' ORDER BY ts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
