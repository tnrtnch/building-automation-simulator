    {
      "id": 5,
      "type": "stat",
      "title": "Simulation time",
      "datasource": {
        "type": "postgres",
        "uid": "climate-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "climate-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT sim_time FROM telemetry WHERE floor = 'f1' AND room = '$room' ORDER BY ts DESC LIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^sim_time$/"
        },
        "textMode": "value",
        "colorMode": "none"
      }
    },
